        {% elif storage == "simd_f64x2_pair" -%}
        let s = SimdF64x2::splat(rhs);
        Self([self.0[0].mul(s), self.0[1].mul(s)])
        {% else -%}
        Self::from_xyzw(self.x * rhs, self.y * rhs, self.z * rhs, self.w * rhs)
        {% endif -%}
    }
}

