impl {{ self_t }} {
    pub const ZERO: Self = Self::from_xyzw({{ zero_lit }}, {{ zero_lit }}, {{ zero_lit }}, {{ zero_lit }});
    pub const IDENTITY: Self = Self::from_xyzw({{ zero_lit }}, {{ zero_lit }}, {{ zero_lit }}, {{ one_lit }});
    pub const NAN: Self = Self::from_xyzw({{ scalar_t }}::NAN, {{ scalar_t }}::NAN, {{ scalar_t }}::NAN, {{ scalar_t }}::NAN);

    #[inline(always)]
    pub(crate) const fn from_xyzw(x: {{ scalar_t }}, y: {{ scalar_t }}, z: {{ scalar_t }}, w: {{ scalar_t }}) -> Self {
        {% if storage == "simd_f32x4" -%}
        Self(SimdF32x4::new(x, y, z, w))
        {% elif storage == "simd_f64x2_pair" -%}
        Self([SimdF64x2::new(x, y), SimdF64x2::new(z, w)])
        {% else -%}
        Self { x, y, z, w }
        {% endif -%}
    }

    #[inline(always)]
    pub(crate) const fn from_wxyz(w: {{ scalar_t }}, x: {{ scalar_t }}, y: {{ scalar_t }}, z: {{ scalar_t }}) -> Self {
        Self::from_xyzw(x, y, z, w)
    }

    #[inline(always)]
    pub(crate) const fn from_array(a: [{{ scalar_t }}; 4]) -> Self {
        Self::from_xyzw(a[0], a[1], a[2], a[3])
    }

    #[inline(always)]
    pub(crate) const fn to_array(self) -> [{{ scalar_t }}; 4] {
        {% if storage == "simd_f32x4" -%}
        self.0.to_array()
        {% elif storage == "simd_f64x2_pair" -%}
        let a0 = self.0[0].to_array();
        let a1 = self.0[1].to_array();
        [a0[0], a0[1], a1[0], a1[1]]
        {% else -%}
        [self.x, self.y, self.z, self.w]
        {% endif -%}
    }

    #[inline(always)]
    pub(crate) fn dot(self, rhs: Self) -> {{ scalar_t }} {
        {% if storage == "simd_f32x4" -%}
        self.0.dot4(rhs.0)
        {% elif storage == "simd_f64x2_pair" -%}
        self.0[0].dot2(rhs.0[0]) + self.0[1].dot2(rhs.0[1])
        {% else -%}
        (self.x * rhs.x + self.z * rhs.z) + (self.y * rhs.y + self.w * rhs.w)
        {% endif -%}
    }

    #[inline(always)]
    pub(crate) fn length_squared(self) -> {{ scalar_t }} {
        self.dot(self)
    }

    #[inline(always)]
    pub(crate) fn length(self) -> {{ scalar_t }} {
        {{ math_mod }}::sqrt(self.dot(self))
    }

    #[inline(always)]
    pub(crate) fn normalize(self) -> Self {
        let len_sq = self.dot(self);
        rglm_debug_assert!(len_sq > {{ zero_lit }});
        self * {{ math_mod }}::inversesqrt(len_sq)
    }

    #[inline(always)]
    pub(crate) fn conjugate(self) -> Self {
        Self::from_xyzw(-self.x, -self.y, -self.z, self.w)
    }

    #[inline(always)]
    pub(crate) fn inverse(self) -> Self {
        let len_sq = self.dot(self);
        rglm_debug_assert!(len_sq > {{ zero_lit }});
        self.conjugate() / len_sq
    }

    #[inline]
    pub(crate) fn from_axis_angle(axis: {{ vec3_t }}, angle: {{ scalar_t }}) -> Self {
        let half = angle * {{ half_lit }};
        let (s, c) = {{ math_mod }}::sin_cos(half);
        let v = axis * s;
        Self::from_xyzw(v.x, v.y, v.z, c)
    }

    #[inline]
    pub(crate) fn to_mat3(self) -> {{ mat3_t }} {
        let x2 = self.x + self.x;
        let y2 = self.y + self.y;
        let z2 = self.z + self.z;
        let xx = self.x * x2;
        let xy = self.x * y2;
        let xz = self.x * z2;
        let yy = self.y * y2;
        let yz = self.y * z2;
        let zz = self.z * z2;
        let wx = self.w * x2;
        let wy = self.w * y2;
        let wz = self.w * z2;
        let one = {{ one_lit }};
        {{ mat3_t }}::from_cols(
            {{ vec3_t }}::new(one - (yy + zz), xy + wz, xz - wy),
            {{ vec3_t }}::new(xy - wz, one - (xx + zz), yz + wx),
            {{ vec3_t }}::new(xz + wy, yz - wx, one - (xx + yy)),
        )
    }

    #[inline]
    pub(crate) fn to_mat4(self) -> {{ mat4_t }} {
        let m = self.to_mat3();
        let zero = {{ zero_lit }};
        let one = {{ one_lit }};
        {{ mat4_t }}::from_cols(
            {{ vec4_t }}::new(m.x_axis.x, m.x_axis.y, m.x_axis.z, zero),
            {{ vec4_t }}::new(m.y_axis.x, m.y_axis.y, m.y_axis.z, zero),
            {{ vec4_t }}::new(m.z_axis.x, m.z_axis.y, m.z_axis.z, zero),
            {{ vec4_t }}::new(zero, zero, zero, one),
        )
    }

    #[inline]
    pub(crate) fn from_mat3(m: {{ mat3_t }}) -> Self {
        let m00 = m.x_axis.x;
        let m01 = m.x_axis.y;
        let m02 = m.x_axis.z;
        let m10 = m.y_axis.x;
        let m11 = m.y_axis.y;
        let m12 = m.y_axis.z;
        let m20 = m.z_axis.x;
        let m21 = m.z_axis.y;
        let m22 = m.z_axis.z;

        let four_x_sq_minus_1 = m00 - m11 - m22;
        let four_y_sq_minus_1 = m11 - m00 - m22;
        let four_z_sq_minus_1 = m22 - m00 - m11;
        let four_w_sq_minus_1 = m00 + m11 + m22;

        let mut biggest_idx = 0usize;
        let mut four_biggest_sq_minus_1 = four_w_sq_minus_1;
        if four_x_sq_minus_1 > four_biggest_sq_minus_1 {
            four_biggest_sq_minus_1 = four_x_sq_minus_1;
            biggest_idx = 1;
        }
        if four_y_sq_minus_1 > four_biggest_sq_minus_1 {
            four_biggest_sq_minus_1 = four_y_sq_minus_1;
            biggest_idx = 2;
        }
        if four_z_sq_minus_1 > four_biggest_sq_minus_1 {
            four_biggest_sq_minus_1 = four_z_sq_minus_1;
            biggest_idx = 3;
        }

        let biggest_val = {{ math_mod }}::sqrt(four_biggest_sq_minus_1 + {{ one_lit }}) * {{ half_lit }};
        let mult = {{ quarter_lit }} / biggest_val;

        match biggest_idx {
            0 => Self::from_wxyz(
                biggest_val,
                (m12 - m21) * mult,
                (m20 - m02) * mult,
                (m01 - m10) * mult,
            ),
            1 => Self::from_wxyz(
                (m12 - m21) * mult,
                biggest_val,
                (m01 + m10) * mult,
                (m20 + m02) * mult,
            ),
            2 => Self::from_wxyz(
                (m20 - m02) * mult,
                (m01 + m10) * mult,
                biggest_val,
                (m12 + m21) * mult,
            ),
            _ => Self::from_wxyz(
                (m01 - m10) * mult,
                (m20 + m02) * mult,
                (m12 + m21) * mult,
                biggest_val,
            ),
        }
    }

    #[inline]
    pub(crate) fn slerp(self, mut z: Self, a: {{ scalar_t }}) -> Self {
        let mut cos_theta = self.dot(z);
        if cos_theta < {{ zero_lit }} {
            z = -z;
            cos_theta = -cos_theta;
        }
        if cos_theta > {{ slerp_threshold_lit }} {
            return (self * ({{ one_lit }} - a) + z * a).normalize();
        }
        let angle = {{ math_mod }}::acos(cos_theta);
        (self * {{ math_mod }}::sin(({{ one_lit }} - a) * angle) + z * {{ math_mod }}::sin(a * angle))
            / {{ math_mod }}::sin(angle)
    }
}

