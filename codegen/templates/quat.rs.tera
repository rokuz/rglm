impl Mul for {{ self_t }} {
    type Output = Self;
    #[inline]
    fn mul(self, rhs: Self) -> Self {
        {% if storage == "simd_f32x4" -%}
        Self(self.0.quat_mul(rhs.0))
        {% else -%}
        let [lx, ly, lz, lw] = self.to_array();
        let [rx, ry, rz, rw] = rhs.to_array();
        Self::from_xyzw(
            lw * rx + lx * rw + ly * rz - lz * ry,
            lw * ry - lx * rz + ly * rw + lz * rx,
            lw * rz + lx * ry - ly * rx + lz * rw,
            lw * rw - lx * rx - ly * ry - lz * rz,
        )
        {% endif -%}
    }
}

impl MulAssign for {{ self_t }} {
    #[inline(always)]
    fn mul_assign(&mut self, rhs: Self) {
        *self = *self * rhs;
    }
}

impl Mul<{{ vec3_t }}> for {{ self_t }} {
    type Output = {{ vec3_t }};
    #[inline]
    fn mul(self, rhs: {{ vec3_t }}) -> {{ vec3_t }} {
        let [qx, qy, qz, qw] = self.to_array();
        let qv = {{ vec3_t }}::new(qx, qy, qz);
        let uv = qv.cross(rhs);
        let uuv = qv.cross(uv);
        rhs + ((uv * qw) + uuv) * {{ two_lit }}
    }
}

impl Mul<{{ self_t }}> for {{ vec3_t }} {
    type Output = {{ vec3_t }};
    #[inline]
    fn mul(self, rhs: {{ self_t }}) -> {{ vec3_t }} {
        rhs.inverse() * self
    }
}

{% if self_t == "Quat" %}
impl Mul<Vec3A> for Quat {
    type Output = Vec3A;
    #[inline]
    fn mul(self, rhs: Vec3A) -> Vec3A {
        let w = self.0.swizzle::<3, 3, 3, 3>();
        let two = SimdF32x4::splat(2.0);
        let uv = self.0.cross3(rhs.0);
        let uuv = self.0.cross3(uv);
        Vec3A(uv.mul_add(w, uuv).mul_add(two, rhs.0))
    }
}

impl Mul<Quat> for Vec3A {
    type Output = Vec3A;
    #[inline]
    fn mul(self, rhs: Quat) -> Vec3A {
        rhs.inverse() * self
    }
}

impl Quat {
    #[inline]
    pub(crate) fn from_mat3a(m: Mat3A) -> Self {
        Self::from_mat3(crate::Mat3::from_cols(
            crate::Vec3::from(m.x_axis),
            crate::Vec3::from(m.y_axis),
            crate::Vec3::from(m.z_axis),
        ))
    }

    #[inline]
    pub(crate) fn to_mat3a(self) -> Mat3A {
        let m = self.to_mat3();
        Mat3A::from_cols(
            Vec3A::from(m.x_axis),
            Vec3A::from(m.y_axis),
            Vec3A::from(m.z_axis),
        )
    }
}
{% endif %}

