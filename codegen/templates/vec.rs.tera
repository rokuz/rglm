    fn from(t: ({% for c in components %}{{ scalar_t }}{% if not loop.last %}, {% endif %}{% endfor %})) -> Self {
        Self::new({% for c in components %}t.{{ loop.index0 }}{% if not loop.last %}, {% endif %}{% endfor %})
    }
}

impl From<{{ self_t }}> for ({% for c in components %}{{ scalar_t }}{% if not loop.last %}, {% endif %}{% endfor %}) {
    #[inline(always)]
    fn from(v: {{ self_t }}) -> Self {
        let a = v.to_array();
        ({% for c in components %}a[{{ loop.index0 }}]{% if not loop.last %}, {% endif %}{% endfor %})
    }
}

{% if self_t == "Vec3A" %}
impl From<Vec3> for Vec3A {
    #[inline(always)]
    fn from(v: Vec3) -> Self {
        Self::new(v.x, v.y, v.z)
    }
}
{% elif self_t == "Vec3" %}
impl From<Vec3A> for Vec3 {
    #[inline(always)]
    fn from(v: Vec3A) -> Self {
        let a = v.to_array();
        Self::new(a[0], a[1], a[2])
    }
}
{% endif %}
