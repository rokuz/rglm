impl Mul<{{ rhs_vec_t }}> for {{ self_t }} {
    type Output = {{ col_t }};
    #[inline(always)]
    fn mul(self, rhs: {{ rhs_vec_t }}) -> {{ col_t }} {
        {% if self_t == "Mat4" or self_t == "Mat4x3A" -%}
        let mut res = self.x_axis.0.mul(rhs.0.swizzle::<0, 0, 0, 0>());
        res = self.y_axis.0.mul_add(rhs.0.swizzle::<1, 1, 1, 1>(), res);
        res = self.z_axis.0.mul_add(rhs.0.swizzle::<2, 2, 2, 2>(), res);
        res = self.w_axis.0.mul_add(rhs.0.swizzle::<3, 3, 3, 3>(), res);
        {{ col_t }}(res)
        {% elif self_t == "Mat3A" -%}
        let mut res = self.x_axis.0.mul(rhs.0.swizzle::<0, 0, 0, 0>());
        res = self.y_axis.0.mul_add(rhs.0.swizzle::<1, 1, 1, 1>(), res);
        res = self.z_axis.0.mul_add(rhs.0.swizzle::<2, 2, 2, 2>(), res);
        {{ col_t }}(res)
        {% else -%}
        let r = rhs.to_array();
        let mut res = self.x_axis * r[0];
        res = self.y_axis.mul_add({{ col_t }}::splat(r[1]), res);
        {% if cols >= 3 -%}
        res = self.z_axis.mul_add({{ col_t }}::splat(r[2]), res);
        {% endif -%}
        {% if cols >= 4 -%}
        res = self.w_axis.mul_add({{ col_t }}::splat(r[3]), res);
        {% endif -%}
        res
        {% endif -%}
    }
}

impl Mul<{{ self_t }}> for {{ col_t }} {
    type Output = {{ rhs_vec_t }};
    #[inline(always)]
